# ===== API (apps/api) =====
# Порт сервера
PORT=3000

# База данных PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vowchek

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ===== Frontend (apps/web) =====
# URL API-бэкенда
VITE_API_URL=http://localhost:3000/api/v1

# ===== Внешние источники цен (PriceProvider) =====
# Ключи заполняются локально, никогда не коммитятся
# PRICE_PROVIDER_STOCKS_API_KEY=
# PRICE_PROVIDER_CRYPTO_API_KEY=